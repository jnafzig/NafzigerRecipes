{% extends "base.html.j2" %}
{% block title %}{{ m.title }} · Nafziger Family Recipes{% endblock %}
{% block main %}
<article class="menu" data-store="menu:{{ m.id }}">
  <header class="recipe-head">
    <span class="eyebrow">Menu</span>
    <h1>{{ m.title }}</h1>
    <p class="byline">{{ m.date_label }}{% if m.serve_time %} · dinner at {{ m.serve_time }}{% endif %}{% if m.serve_at %} at {{ m.serve_at }}{% endif %}</p>
    <p class="actions">
      {% if m.groceries %}<a class="button" href="{{ m.id }}-groceries.html">Grocery list</a>{% endif %}
      {% if m.plan %}<a class="button" href="#plan">Plan</a>{% endif %}
      <a class="button" href="cards.html?only={{ m.dishes|map(attribute='id')|join(',') }}">Print all cards</a>
    </p>
  </header>

  <ul class="dishes">
    {% for d in m.dishes %}
    <li><a class="{{ m.dish_class[d.id] }}" href="{{ d.id }}.html">{{ d.title }}</a> <span class="by">{{ d.category_label }}</span>{% if d.kitchen %} <span class="kitchen-tag {{ m.kitchen_class[d.kitchen] }}">{{ d.kitchen }}</span>{% endif %}</li>
    {% endfor %}
  </ul>

  {% if m.plan %}
  <h2 id="plan">Plan</h2>
  {% include "kitchen-filter.html.j2" %}
  {% for day in m.plan %}
  <section class="day" data-date="{{ day.date }}">
    <h3>{{ day.label }} <span class="when">{{ day.relative }}</span></h3>
    <ol class="checklist tasks">
      {% for t in day.tasks %}
      <li data-kitchens="{{ t.kitchens|join(' ') }}">
        <label>
          <input type="checkbox" data-key="{{ t.key }}">
          <span class="time">{{ t.time or "" }}</span>
          <span class="what">
            {% if t.recipe or t.kitchens %}<span class="dish">{% if t.recipe %}<a class="{{ m.dish_class[t.recipe] }}" href="{{ t.recipe }}.html">{{ titles[t.recipe] }}</a>{% endif %}{% for k in t.kitchens %} <span class="kitchen-tag {{ m.kitchen_class[k] }}">{{ k }}</span>{% endfor %}</span>{% endif %}
            {{ t.task }}
          </span>
        </label>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endfor %}
  {% endif %}

  {% if m.notes %}
  <h2>Notes</h2>
  <ul class="notes">
    {% for n in m.notes %}<li>{{ n }}</li>{% endfor %}
  </ul>
  {% endif %}
</article>

{% include "checklist.js.j2" %}
{% if m.plan %}
<script>
kitchenFilter.onChange(() => {
  for (const li of document.querySelectorAll(".tasks li")) li.hidden = !kitchenFilter.matches(li);
  for (const day of document.querySelectorAll(".day")) day.hidden = [...day.querySelectorAll("li")].every(li => li.hidden);
});
</script>
{% endif %}
{% endblock %}
