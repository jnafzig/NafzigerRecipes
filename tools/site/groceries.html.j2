{% extends "base.html.j2" %}
{% block title %}{{ m.title }} grocery list · Nafziger Family Recipes{% endblock %}
{% block main %}
<article class="menu" data-store="groceries:{{ m.id }}">
  <header class="recipe-head">
    <a class="eyebrow" href="{{ m.id }}.html">{{ m.title }}</a>
    <h1>Grocery list</h1>
    <p class="byline">Totals for every dish on the menu. Check the pantry before you go.</p>
  </header>
  {% include "kitchen-filter.html.j2" %}

  {% for sec in m.groceries %}
  <section class="aisle">
    <h3>{{ sec.section }}</h3>
    <ul class="checklist groceries">
      {% for g in sec["items"] %}
      <li data-key="{{ g.key }}" data-kitchens="{{ g.kitchens|join(' ') }}">
        <label>
          <input type="checkbox">
          <span class="what">
            <b>{{ g.item }}</b>{% if g.amount %} <span class="amt">{{ g.amount }}</span>{% endif %}
            <span class="for">{% if g.note %}{{ g.note }} · {% endif %}{% for r in g["for"] %}<span class="{{ m.dish_class[r] }}">{{ titles[r] }}</span>{% if not loop.last %}, {% endif %}{% endfor %}{% for k in g.kitchens %} <span class="kitchen-tag {{ m.kitchen_class[k] }}">{{ k }}</span>{% endfor %}</span>
          </span>
        </label>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}

  <div class="hide-bar">
    <p class="actions">
      <button type="button" class="button" id="hide-checked">Hide checked items</button>
      <button type="button" class="button" id="show-hidden" hidden>Show hidden items</button>
    </p>
  </div>
</article>

<script>
// Tick what you already have, then "Hide checked items" before heading to the store; anything
// ticked after that (in the cart) stays on the list, crossed out. "Show hidden items" undoes it.
// Both lists are remembered in this browser only. With a kitchen picked, the counts and buttons
// cover only that kitchen's items.
const storeKey = document.querySelector("[data-store]").dataset.store;
const load = k => { try { return JSON.parse(localStorage.getItem(k)) || {}; } catch { return {}; } };
const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
const checked = load(storeKey);
const hidden = load(`${storeKey}:hidden`);
const items = [...document.querySelectorAll(".groceries li")];
const hideButton = document.getElementById("hide-checked");
const showButton = document.getElementById("show-hidden");
const label = (n, word) => `${n} ${word} item${n === 1 ? "" : "s"}`;

const shown = () => items.filter(kitchenFilter.matches);

function render() {
  for (const li of items) {
    li.querySelector("input").checked = !!checked[li.dataset.key];
    li.hidden = !!hidden[li.dataset.key] || !kitchenFilter.matches(li);
  }
  for (const sec of document.querySelectorAll(".aisle")) {
    sec.hidden = [...sec.querySelectorAll("li")].every(li => li.hidden);
  }
  const nHidden = shown().filter(li => hidden[li.dataset.key]).length;
  const nToHide = shown().filter(li => !hidden[li.dataset.key] && checked[li.dataset.key]).length;
  hideButton.disabled = nToHide === 0;
  hideButton.textContent = nToHide ? `Hide ${label(nToHide, "checked")}` : "Hide checked items";
  showButton.hidden = nHidden === 0;
  showButton.textContent = `Show ${label(nHidden, "hidden")}`;
}

for (const li of items) {
  li.querySelector("input").addEventListener("change", e => {
    checked[li.dataset.key] = e.target.checked;
    save(storeKey, checked);
    render();
  });
}
hideButton.addEventListener("click", () => {
  for (const li of shown()) if (checked[li.dataset.key]) hidden[li.dataset.key] = true;
  save(`${storeKey}:hidden`, hidden);
  render();
  window.scrollTo({ top: 0, behavior: "smooth" });
});
showButton.addEventListener("click", () => {
  for (const li of shown()) delete hidden[li.dataset.key];
  save(`${storeKey}:hidden`, hidden);
  render();
});
kitchenFilter.onChange(render);
</script>
{% endblock %}
