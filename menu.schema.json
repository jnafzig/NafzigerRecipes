{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "menu.schema.json",
  "title": "Nafziger Family Menu",
  "description": "A meal made from several recipes, with a day-by-day plan for when to do the work.",
  "type": "object",
  "required": [
    "id",
    "title",
    "date",
    "dishes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Kebab-case slug; must match the file name (menus/<id>.yaml) and not collide with a recipe id.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "description": "The day of the meal, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "serve_time": {
      "description": "When the meal is served, e.g. \"1:00 pm\".",
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kitchens": {
      "description": "Kitchens the cooking is split between. Dishes, tasks, and grocery items name one by id, and the menu and grocery pages can be filtered to one kitchen.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cook"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Short name for the kitchen, e.g. a house number like \"406\".",
            "type": "string"
          },
          "cook": {
            "description": "Who's responsible for that kitchen's dishes.",
            "type": "string"
          }
        }
      }
    },
    "serve_at": {
      "description": "Kitchen id where the meal is served.",
      "type": [
        "string",
        "null"
      ]
    },
    "dishes": {
      "description": "Recipes in the order they appear on the menu: a recipe id, or {recipe, kitchen} to say which kitchen makes it.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/recipe_id"
          },
          {
            "type": "object",
            "required": [
              "recipe",
              "kitchen"
            ],
            "additionalProperties": false,
            "properties": {
              "recipe": {
                "$ref": "#/$defs/recipe_id"
              },
              "kitchen": {
                "description": "Kitchen id; its tasks default to this kitchen.",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "groceries": {
      "description": "Shopping list, grouped by store section. Amounts are totals across the menu's dishes.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "section": {
            "description": "Store section, e.g. \"Produce\", \"Dairy & Eggs\".",
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string"
                },
                "amount": {
                  "description": "What to buy, e.g. \"2 bags (12 oz each)\".",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "for": {
                  "description": "Recipe ids that use it; each must be one of the menu's dishes.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "note": {
                  "description": "How much each dish needs, or what to check.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kitchen": {
                  "description": "Kitchen id that buys it. Defaults to the kitchens of the dishes in `for`.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "plan": {
      "description": "When to do the work, one entry per day in order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "tasks"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "task"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "description": "Clock time or part of the day, e.g. \"8:15 am\", \"evening\", \"after dinner\".",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recipe": {
                  "description": "Recipe id this task belongs to; must be one of the menu's dishes.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "task": {
                  "type": "string"
                },
                "kitchen": {
                  "description": "Kitchen id that does it. Defaults to the recipe's kitchen; a task with neither is for everyone.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
