{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "menu.schema.json",
  "title": "Nafziger Family Menu",
  "description": "A meal made from several recipes, with a day-by-day plan for when to do the work.",
  "type": "object",
  "required": ["id", "title", "date", "dishes"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Kebab-case slug; must match the file name (menus/<id>.yaml) and not collide with a recipe id.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string" },
    "date": {
      "description": "The day of the meal, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "serve_time": {
      "description": "When the meal is served, e.g. \"1:00 pm\".",
      "type": ["string", "null"]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dishes": {
      "description": "Recipe ids, in the order they appear on the menu.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "plan": {
      "description": "When to do the work, one entry per day in order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "tasks"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["task"],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "description": "Clock time or part of the day, e.g. \"8:15 am\", \"evening\", \"after dinner\".",
                  "type": ["string", "null"]
                },
                "recipe": {
                  "description": "Recipe id this task belongs to; must be one of the menu's dishes.",
                  "type": ["string", "null"]
                },
                "task": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
